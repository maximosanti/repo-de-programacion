/* ==================== APP SHELL FULL-SCREEN ==================== */
.app-shell {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    min-height: 100vh;
    width: 100%;
    background: var(--fondo-body);
}

/* SIDEBAR LATERAL FIJA */
.app-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 270px;
    max-width: 100%;
    background: var(--fondo-sidebar);
    border-right: 1px solid var(--borde-suave);
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 50;
    overflow-y: auto;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 6px;
}

.logo-wrapper-header {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.28), rgba(168, 85, 247, 0.14));
    border: 1px solid rgba(168, 85, 247, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(109, 40, 217, 0.22);
}

.logo-cuaderno-mini {
    width: 36px;
    height: 36px;
    display: block;
}

.sidebar-brand-text h1 {
    font-size: 21px;
    line-height: 1.1;
}

.sidebar-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    color: var(--texto-tenue);
    margin-top: 2px;
}

.sidebar-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--texto-tenue);
    padding: 0 10px;
    margin-bottom: -10px;
}

/* NAVEGACIÓN VERTICAL EN SIDEBAR */
.main-navbar {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
}

.nav-tab {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 11px;
    width: 100%;
    min-height: 42px;
    padding: 10px 14px;
    background: transparent;
    color: var(--texto-secundario);
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
}

.nav-tab i, .nav-tab svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.nav-tab:hover {
    background: var(--fondo-btn-secundario);
    color: var(--texto-titulo);
}

.nav-tab.active {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(124, 58, 237, 0.14));
    color: var(--color-primario);
    border-color: var(--borde-fuerte);
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.14);
}

/* FOOTER DE USUARIO EN SIDEBAR */
.sidebar-footer {
    border-top: 1px solid var(--borde-suave);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sidebar-user-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
}

.sidebar-user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--fondo-chip);
    color: var(--color-primario);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.sidebar-user-avatar i, .sidebar-user-avatar svg {
    width: 18px;
    height: 18px;
}

.sidebar-user-info {
    min-width: 0;
    flex: 1;
}

.sidebar-user-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--texto-principal);
    line-height: 1.3;
    word-break: break-word;
}

.sidebar-footer-actions {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 8px;
}

.sidebar-footer-actions button {
    min-height: 36px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ÁREA DE TRABAJO PRINCIPAL + TOPBAR */
.app-workspace {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 100vh;
}

.workspace-topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--fondo-topbar);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--borde-suave);
    padding: 16px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.topbar-context {
    display: flex;
    align-items: center;
    gap: 12px;
}

.topbar-badge {
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 700;
    background: var(--fondo-chip);
    color: var(--color-primario);
    border: 1px solid var(--borde-suave);
}

.topbar-title {
    font-size: 20px;
    color: var(--texto-titulo);
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.btn-topbar-cta {
    width: auto;
    min-height: 38px;
    padding: 7px 15px;
    font-size: 13px;
}

.workspace-main {
    padding: 28px 32px 48px;
    max-width: 1380px;
    width: 100%;
    margin: 0 auto;
}

/* SISTEMA DE PESTAÑAS */
.tab-content {
    display: none;
    animation: fadeTab 0.2s ease-out;
}

.tab-content.active {
    display: block;
}

@keyframes fadeTab {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}

/* INICIO: GRID DE 2 COLUMNAS */
.inicio-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 22px;
    align-items: start;
}

.inicio-columna-principal {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.panel-bienvenida, .calendario-inicio-card {
    background: var(--fondo-tarjeta);
    border: 1px solid var(--borde-suave);
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--sombra-card);
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.calendario-card-titulo {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primario);
}

.calendario-card-titulo i, .calendario-card-titulo svg {
    width: 18px;
    height: 18px;
}

/* TARJETAS KPI EN PANEL BIENVENIDA */
.bienvenida-datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.bienvenida-chip {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    background: var(--fondo-subtarjeta);
    color: var(--texto-titulo);
    border: 1px solid var(--borde-suave);
    display: flex;
    align-items: center;
    gap: 6px;
}

.bienvenida-proxima, .bienvenida-semana, .bienvenida-vacio {
    font-size: 14px;
    color: var(--texto-secundario);
}

.bienvenida-proxima {
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--fondo-chip);
    border: 1px solid var(--borde-suave);
    color: var(--texto-principal);
}

.cursada-lista {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.cursada-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
    font-size: 13.5px;
    gap: 8px;
}

.badge-alerta-clase {
    background: rgba(245, 158, 11, 0.18);
    color: #d97706;
    border: 1px solid rgba(245, 158, 11, 0.4);
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
}

html[data-tema="oscuro"] .badge-alerta-clase {
    color: #fbbf24;
}

.detalle-dia-calendario {
    border-top: 1px solid var(--borde-suave);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.detalle-vacio {
    font-size: 12.5px;
    color: var(--texto-tenue);
    text-align: center;
}

.detalle-item-dia {
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
    border-left: 3px solid var(--color-primario);
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 12.5px;
}

/* HORARIO SEMANAL */
.horario-form-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 18px;
}

.horario-semanal-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 22px;
}

.horario-columna {
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 240px;
}

.horario-columna h4 {
    text-align: center;
    font-size: 14px;
    color: var(--color-primario);
    border-bottom: 1px solid var(--borde-suave);
    padding-bottom: 8px;
}

.clase-card {
    background: var(--fondo-tarjeta);
    border: 1px solid var(--borde-suave);
    border-radius: 10px;
    padding: 10px;
    font-size: 12.5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    transition: transform 0.15s ease, border-color 0.15s ease;
}

.clase-card:hover {
    transform: translateY(-1px);
    border-color: var(--borde-fuerte);
}

.clase-hora {
    display: block;
    font-size: 11px;
    color: var(--texto-tenue);
    margin-top: 2px;
}

.btn-borrar-clase {
    width: 26px;
    min-height: 26px;
    padding: 0;
    border-radius: 7px;
    background: rgba(239, 68, 68, 0.14);
    color: var(--color-peligro);
    font-size: 11px;
}

.btn-borrar-clase:hover {
    background: var(--color-peligro);
    color: #ffffff;
}

/* ALERTAS HOY / MAÑANA */
.hoy-manana-container {
    background: var(--fondo-tarjeta);
    border: 1px solid var(--borde-suave);
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: var(--sombra-card);
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.hoy-manana-container:empty {
    display: none;
}

.urgente-item {
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
    border-left: 4px solid #64748b;
    font-size: 13.5px;
}
.urgente-item.urgente-hoy { border-left-color: var(--color-peligro); }
.urgente-item.urgente-manana { border-left-color: var(--color-alerta); }

.urgente-etiqueta {
    font-weight: 700;
    margin-right: 6px;
    text-transform: uppercase;
    font-size: 11px;
}

/* MÉTRICAS Y SIMULADOR */
.metricas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
}

.sidebar-widget {
    background: var(--fondo-tarjeta);
    border: 1px solid var(--borde-suave);
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--sombra-card);
}

.progreso-materias {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.progreso-fila { display: flex; flex-direction: column; gap: 5px; }
.progreso-encabezado { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--texto-secundario); }
.progreso-barra { display: flex; height: 7px; border-radius: 999px; overflow: hidden; background: rgba(139, 92, 246, 0.14); }
.segmento-aprobado { background: var(--color-aprobado); }
.segmento-desaprobado { background: var(--color-desaprobado); }
.segmento-entregada { background: var(--color-entregada); }
.segmento-pendiente { background: var(--color-acento); }

.promedio-box, .simulador-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.promedio-box {
    align-items: center;
    text-align: center;
}

.resultado-simulador {
    padding: 14px;
    border-radius: 12px;
    background: var(--fondo-simulador);
    border: 1px solid var(--borde-suave);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--texto-secundario);
}

#promedio {
    font-weight: 700;
    font-size: 17px;
    color: var(--texto-titulo);
}

.promedios-materia-lista {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 7px;
    text-align: left;
}

.promedio-materia-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--fondo-subtarjeta);
    border: 1px solid var(--borde-suave);
    font-size: 12.5px;
}

.promedio-materia-nota {
    font-weight: 700;
    padding: 2px 9px;
    border-radius: 999px;
}

.promedio-materia-nota.aprobada {
    background: rgba(74, 222, 128, 0.16);
    color: var(--color-aprobado);
}

.promedio-materia-nota.desaprobada {
    background: rgba(248, 113, 113, 0.16);
    color: var(--color-desaprobado);
}

/* CALENDARIO */
.calendario-grande {
    background: var(--fondo-calendario-popup);
    border: 1px solid var(--borde-suave);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
    box-shadow: var(--sombra-card);
}

.calendario-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    color: var(--texto-titulo);
}

.calendario-header button {
    width: auto;
    min-height: 30px;
    padding: 2px 12px;
    background: var(--fondo-btn-secundario);
    color: var(--texto-principal);
}

.dias-semana, .dias-calendario {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    text-align: center;
}

.dias-semana span {
    color: var(--texto-tenue);
    font-size: 11.5px;
    font-weight: 700;
}

.dia-celda {
    padding: 8px 0;
    border-radius: 8px;
    background: var(--fondo-celda-dia);
    color: var(--texto-principal);
    font-size: 12.5px;
    cursor: pointer;
    transition: transform 0.15s, background 0.15s;
}

.dia-celda:hover:not(.vacio-dia) {
    transform: scale(1.06);
}

.dia-celda.con-tarea { background: rgba(139, 92, 246, 0.32); border: 1px solid var(--color-primario); }
.dia-celda.con-recuperatorio { background: rgba(245, 158, 11, 0.32); border: 1px solid #f59e0b; }
.dia-celda.con-ambos { background: linear-gradient(135deg, rgba(139, 92, 246, 0.38), rgba(245, 158, 11, 0.38)); border: 1px solid var(--color-marca); }
.dia-celda.hoy { outline: 2px solid var(--color-primario); font-weight: 700; }
.dia-celda.seleccionado { box-shadow: 0 0 0 2px var(--color-marca); font-weight: 700; }

.calendario-leyenda {
    display: flex;
    gap: 14px;
    font-size: 11.5px;
    color: var(--texto-secundario);
    justify-content: center;
}

.punto {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
}
.punto.tarea { background: var(--color-primario); }
.punto.recuperatorio { background: #f59e0b; }

/* RESPONSIVE */
@media (max-width: 1120px) {
    .inicio-grid { grid-template-columns: 1fr; }
    .metricas-grid { grid-template-columns: 1fr; }
    .horario-semanal-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 860px) {
    .app-shell {
        grid-template-columns: 1fr;
    }
    .app-sidebar {
        position: static;
        width: 100%;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--borde-suave);
        padding: 16px;
        gap: 12px;
    }
    .sidebar-section-label {
        display: none;
    }
    .main-navbar {
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 4px;
    }
    .nav-tab {
        width: auto;
        white-space: nowrap;
    }
    .sidebar-footer {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .workspace-topbar {
        padding: 14px 18px;
    }
    .workspace-main {
        padding: 18px 16px 36px;
    }
    .bienvenida-datos {
        grid-template-columns: 1fr;
    }
    .horario-form-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
    .horario-form-grid { grid-template-columns: 1fr; }
    .horario-semanal-grid { grid-template-columns: 1fr; }
}
