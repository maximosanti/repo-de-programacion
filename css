* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    background: linear-gradient(-45deg, #1a2a6c, #232526, #0f2027, #3a1c71, #232526);
    background-size: 400% 400%;
    animation: cambiarFondo 18s ease infinite;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 12px;
}

h1, h2, h3, h4 {
    font-family: 'Space Grotesk', Arial, sans-serif;
}

@keyframes cambiarFondo {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.container {
    width: 100%;
    max-width: 1100px;
}

.card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f1f1f1;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.subtitulo {
    color: #cfcfcf;
    font-size: 14px;
}

.header-agenda {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 18px;
}

.header-botones {
    display: flex;
    gap: 8px;
}

.form-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
}

.row {
    display: flex;
    gap: 12px;
}

input, select {
    width: 100%;
    padding: 12px 14px;
    font-size: 16px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.08);
    color: #f1f1f1;
}

input::placeholder {
    color: #b8b8b8;
}

select option {
    color: #222;
}

/* Stepper propio para el campo Nota */
input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

input[type=number] {
    -moz-appearance: textfield;
}

.input-stepper {
    position: relative;
    flex: 1;
}

.input-stepper input {
    padding-right: 34px;
}

.stepper-botones {
    position: absolute;
    right: 4px;
    top: 4px;
    bottom: 4px;
    width: 26px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.stepper-btn {
    flex: 1;
    width: 100%;
    min-height: 0;
    padding: 0;
    margin: 0;
    font-size: 10px;
    line-height: 1;
    background: rgba(255, 255, 255, 0.12);
    color: #f1f1f1;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.stepper-btn:hover {
    background: rgba(255, 255, 255, 0.25);
}

/* Fecha + botón de calendario grande */
.input-fecha-wrapper {
    flex: 1;
    display: flex;
    gap: 6px;
}

.input-fecha-wrapper input {
    flex: 1;
}

.btn-calendario {
    width: 46px;
    min-height: 46px;
    margin-top: 0;
    padding: 0;
    font-size: 18px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    cursor: pointer;
}

.btn-calendario:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* Calendario grande */
.calendario-grande {
    margin-top: -4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.calendario-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
}

.calendario-header button {
    width: auto;
    min-height: 32px;
    padding: 4px 14px;
    margin-top: 0;
}

.dias-semana,
.dias-calendario {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    text-align: center;
}

.dias-semana span {
    color: #aaaaaa;
    font-size: 12px;
}

.dia-celda {
    padding: 8px 0;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    font-size: 14px;
}

.dia-celda:hover {
    background: rgba(255, 255, 255, 0.18);
}

.dia-celda.vacio-dia {
    cursor: default;
    background: transparent;
}

.dia-celda.con-tarea {
    background: rgba(33, 150, 243, 0.45);
    border: 1px solid #14b8a6;
}

.dia-celda.con-recuperatorio {
    background: rgba(255, 152, 0, 0.45);
    border: 1px solid #ff9800;
}

.dia-celda.con-ambos {
    background: linear-gradient(135deg, rgba(33, 150, 243, 0.45), rgba(255, 152, 0, 0.45));
    border: 1px solid #ffffff;
}

.dia-celda.hoy {
    outline: 2px solid #ffffff;
}

.calendario-leyenda {
    display: flex;
    gap: 16px;
    font-size: 12px;
    color: #cccccc;
}

.punto {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 4px;
}

.punto.tarea {
    background: #14b8a6;
}

.punto.recuperatorio {
    background: #ff9800;
}

/* Scrollbar personalizada */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(20, 184, 166, 0.5);
    border-radius: 8px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(20, 184, 166, 0.8);
}

/* Resumen con contadores */
.resumen-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.stat-item {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
}

.stat-total { color: #f1f1f1; }
.stat-pendiente { color: #64b5f6; }
.stat-entregada { color: #14b8a6; }
.stat-aprobada { color: #66bb6a; }
.stat-desaprobada { color: #ef5350; }

/* Vista "Hoy y mañana" */
.hoy-manana {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.hoy-manana h4 {
    color: #e0e0e0;
}

.urgente-item {
    padding: 10px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border-left: 4px solid #888;
    font-size: 14px;
}

.urgente-item.urgente-hoy {
    border-left-color: #ef5350;
}

.urgente-item.urgente-manana {
    border-left-color: #ffb74d;
}

.urgente-etiqueta {
    display: inline-block;
    font-weight: bold;
    margin-right: 6px;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: #cccccc;
}

/* Fila de filtro + búsqueda */
.controles-listado {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.controles-listado .filtro-container {
    flex: 1;
    min-width: 200px;
}

/* Progreso por materia */
.progreso-materias {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.progreso-materias h4 {
    color: #e0e0e0;
}

.progreso-fila {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.progreso-encabezado {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: #d0d0d0;
}

.progreso-numeros {
    color: #aaaaaa;
}

.progreso-barra {
    display: flex;
    height: 8px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
}

.segmento-aprobado {
    background: #66bb6a;
}

.segmento-desaprobado {
    background: #ef5350;
}

.segmento-entregada {
    background: #14b8a6;
}

.segmento-pendiente {
    background: #64b5f6;
}

/* Toast de confirmación */
.toast {
    position: fixed;
    bottom: 90px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: rgba(20, 30, 40, 0.95);
    color: #f1f1f1;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 1500;
}

.toast.mostrar {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

/* ============ TEMA CLARO ============ */
body[data-theme="light"] {
    background: linear-gradient(-45deg, #e0f7fa, #fdf6e3, #e8f5e9, #fce4ec, #e0f7fa);
}

body[data-theme="light"] .card {
    background: rgba(0, 0, 0, 0.035);
    border-color: rgba(0, 0, 0, 0.1);
    color: #1f2937;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

body[data-theme="light"] .subtitulo {
    color: #555555;
}

body[data-theme="light"] .header-agenda {
    border-bottom-color: rgba(0, 0, 0, 0.12);
}

body[data-theme="light"] input,
body[data-theme="light"] select {
    background-color: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.15);
    color: #1f2937;
}

body[data-theme="light"] input::placeholder {
    color: #777777;
}

body[data-theme="light"] .stepper-btn,
body[data-theme="light"] .btn-calendario,
body[data-theme="light"] .btn-tema {
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.15);
    color: #1f2937;
}

body[data-theme="light"] .calendario-grande {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
}

body[data-theme="light"] .dias-semana span {
    color: #555555;
}

body[data-theme="light"] .dia-celda {
    background: rgba(0, 0, 0, 0.035);
    color: #1f2937;
}

body[data-theme="light"] .dia-celda:hover {
    background: rgba(0, 0, 0, 0.08);
}

body[data-theme="light"] .calendario-leyenda {
    color: #444444;
}

body[data-theme="light"] .listado-container {
    border-top-color: rgba(0, 0, 0, 0.12);
}

body[data-theme="light"] .filtro-container label {
    color: #444444;
}

body[data-theme="light"] .seccion-tareas,
body[data-theme="light"] .seccion-recuperatorios {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
}

body[data-theme="light"] .seccion-tareas h4,
body[data-theme="light"] .seccion-recuperatorios h4 {
    color: #333333;
}

body[data-theme="light"] li {
    background: rgba(0, 0, 0, 0.035);
    color: #1f2937;
}

body[data-theme="light"] li:not(.vacio):hover {
    background: rgba(0, 0, 0, 0.07);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
}

body[data-theme="light"] li.vacio {
    color: #777777;
}

body[data-theme="light"] .estado-pendiente {
    color: #1976d2;
}

body[data-theme="light"] .estado-aprobado {
    color: #2e7d32;
}

body[data-theme="light"] .estado-desaprobado {
    color: #c62828;
}

body[data-theme="light"] .resumen-stats .stat-item {
    background: rgba(0, 0, 0, 0.05);
}

body[data-theme="light"] .stat-total {
    color: #1f2937;
}

body[data-theme="light"] .hoy-manana h4 {
    color: #333333;
}

body[data-theme="light"] .urgente-item {
    background: rgba(0, 0, 0, 0.04);
}

body[data-theme="light"] .urgente-etiqueta {
    color: #555555;
}

body[data-theme="light"] .progreso-materias h4 {
    color: #333333;
}

body[data-theme="light"] .progreso-encabezado {
    color: #333333;
}

body[data-theme="light"] .progreso-numeros {
    color: #666666;
}

body[data-theme="light"] .progreso-barra {
    background: rgba(0, 0, 0, 0.06);
}

body[data-theme="light"] #promedio {
    color: #1f2937;
}

body[data-theme="light"] .panel-asistente {
    background: rgba(250, 250, 252, 0.97);
    border-color: rgba(0, 0, 0, 0.12);
}

body[data-theme="light"] .asistente-header {
    background: rgba(0, 0, 0, 0.04);
    color: #1f2937;
}

body[data-theme="light"] .mensaje-bot {
    background: rgba(0, 0, 0, 0.06);
    color: #1f2937;
}

body[data-theme="light"] .asistente-input-row {
    border-top-color: rgba(0, 0, 0, 0.1);
}

body[data-theme="light"] .toast {
    background: rgba(255, 255, 255, 0.97);
    color: #1f2937;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
}

body[data-theme="light"] .panel-bienvenida {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
}

body[data-theme="light"] .panel-bienvenida h4 {
    color: #1f2937;
}

body[data-theme="light"] .bienvenida-datos {
    color: #333333;
}

body[data-theme="light"] .bienvenida-proxima,
body[data-theme="light"] .bienvenida-semana {
    color: #555555;
}

body[data-theme="light"] .bienvenida-vacio {
    color: #666666;
}

/* Filtro por materia */
.filtro-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.filtro-container label {
    font-size: 13px;
    color: #cfcfcf;
}

/* Botón editar en cada ítem */
.btn-editar {
    background: #607d8b;
}

.btn-entregar {
    background: #14b8a6;
    font-size: 13px;
}

.btn-deshacer-entrega {
    background: #757575;
    font-size: 13px;
}

/* ---------- ASISTENTE FLOTANTE ---------- */
.boton-asistente {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 56px;
    min-height: 56px;
    height: 56px;
    border-radius: 50%;
    background: #14b8a6;
    font-size: 24px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    z-index: 1000;
    margin-top: 0;
}

.panel-asistente {
    position: fixed;
    bottom: 88px;
    right: 20px;
    width: 300px;
    max-width: calc(100vw - 40px);
    height: 400px;
    max-height: calc(100vh - 120px);
    background: rgba(30, 30, 40, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 1000;
}

.asistente-header {
    background: rgba(255, 255, 255, 0.08);
    color: #f1f1f1;
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    font-size: 14px;
}

.cerrar-asistente {
    width: auto;
    min-height: 24px;
    height: 24px;
    padding: 0 8px;
    margin-top: 0;
    background: transparent;
    font-size: 14px;
}

.cerrar-asistente:hover {
    background: rgba(255, 255, 255, 0.15);
}

.asistente-mensajes {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.mensaje-bot,
.mensaje-usuario {
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.4;
}

.mensaje-bot {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.1);
    color: #f1f1f1;
    border-bottom-left-radius: 2px;
}

.mensaje-usuario {
    align-self: flex-end;
    background: #14b8a6;
    color: white;
    border-bottom-right-radius: 2px;
}

.asistente-input-row {
    display: flex;
    gap: 6px;
    padding: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.asistente-input-row input {
    flex: 1;
    padding: 8px 10px;
    font-size: 13px;
}

.asistente-input-row button {
    width: 38px;
    min-height: 38px;
    padding: 0;
    margin-top: 0;
    font-size: 16px;
}

@media (max-width: 480px) {
    .panel-asistente {
        width: calc(100vw - 24px);
        right: 12px;
    }

    .boton-asistente {
        right: 12px;
    }
}

button {
    width: 100%;
    min-height: 46px;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #14b8a6;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 6px;
    transition: background 0.2s, transform 0.15s ease;
}

button:hover {
    background: #0d9488;
    transform: translateY(-1px);
}

.btn-secundario {
    background: #757575;
}

.btn-danger {
    background: #f44336;
}

.btn-tema {
    width: 46px;
    min-height: 46px;
    flex: 0 0 auto;
    margin-top: 0;
    padding: 0;
    font-size: 18px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    cursor: pointer;
}

.btn-tema:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* Panel de bienvenida */
.panel-bienvenida {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.panel-bienvenida h4 {
    color: #f1f1f1;
}

.bienvenida-datos {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 14px;
    color: #e0e0e0;
}

.bienvenida-proxima,
.bienvenida-semana {
    font-size: 13px;
    color: #cfcfcf;
}

.bienvenida-vacio {
    color: #aaaaaa;
    font-size: 14px;
}

.listado-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 2px solid rgba(255, 255, 255, 0.15);
    padding-top: 20px;
}

.seccion-tareas,
.seccion-recuperatorios {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 16px;
}

.seccion-tareas h4,
.seccion-recuperatorios h4 {
    margin-bottom: 8px;
    padding-bottom: 8px;
    color: #e0e0e0;
    border-bottom: 2px solid transparent;
}

.seccion-tareas h4 {
    border-bottom-color: #14b8a6;
}

.seccion-recuperatorios h4 {
    border-bottom-color: #ff9800;
}

.seccion-recuperatorios li {
    border-left-color: #ff9800;
}

ul {
    list-style: none;
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px;
}

li {
    background: rgba(255, 255, 255, 0.07);
    color: #f1f1f1;
    padding: 12px;
    border-radius: 8px;
    border-left: 5px solid #14b8a6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}

li:not(.vacio):hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    background: rgba(255, 255, 255, 0.11);
}

li.vacio {
    grid-column: 1 / -1;
    border-left: none;
    color: #aaaaaa;
    justify-content: center;
}

.tarea-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.dot-materia {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
}

.estado {
    font-weight: bold;
    font-size: 14px;
}

.estado-aprobado {
    color: #66bb6a;
}

.estado-desaprobado {
    color: #ef5350;
}

.estado-pendiente {
    color: #64b5f6;
}

.estado-entregada {
    color: #14b8a6;
}

.acciones {
    display: flex;
    gap: 6px;
}

.acciones button {
    width: auto;
    min-height: 38px;
    padding: 6px 12px;
}

.btn-recuperar {
    background: #ff9800;
    font-size: 14px;
}

.btn-eliminar {
    background: #ef5350;
}

.promedio-box {
    margin-top: 15px;
    padding-top: 15px;
