body{

font-family: Arial, sans-serif;

background: linear-gradient(135deg,#4facfe,#00f2fe);

margin:0;

padding:0;

display:flex;

justify-content:center;

align-items:center;

min-height:100vh;

}



.container{

background:white;

padding:30px;

width:600px;

border-radius:15px;

box-shadow:0 10px 30px rgba(0,0,0,0.2);

}



h1{

text-align:center;

color:#333;

}



h2{

margin-top:20px;

}



input, select{

width:100%;

padding:10px;

margin-top:8px;

margin-bottom:10px;

border-radius:8px;

border:1px solid #ccc;

}



button{

padding:10px;

border:none;

border-radius:8px;

background:#2196F3;

color:white;

cursor:pointer;

margin-top:5px;

transition:0.3s;

}



button:hover{

background:#0b7dda;

}



ul{

padding:0;

margin-top:20px;

}



li{

list-style:none;

background:#f4f4f4;

padding:15px;

margin-bottom:10px;

border-radius:10px;

display:flex;

justify-content:space-between;

align-items:center;

}



.tarea-info{

display:flex;

flex-direction:column;

}



.estado{

font-weight:bold;

}



.eliminar{

background:red;

}
